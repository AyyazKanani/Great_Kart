# Copy this file to .env and fill your real values
# DO NOT commit .env to git - it is already in .gitignore

# For real Gmail sending, set these:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your_email@gmail.com

# If you leave EMAIL_HOST_USER empty, emails will just print in console (safe for local dev)
